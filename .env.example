# Example only — the real file lives on the host at /data/container/hermes/.env
# (mounted at /opt/data/.env inside the container) and is never committed.

# --- LLM provider: OpenCode Go (https://opencode.ai/auth) ---
OPENCODE_GO_API_KEY=

# --- Hermes web dashboard auth ---
# A non-loopback bind (0.0.0.0, used behind Traefik) makes Hermes refuse to
# start the dashboard unless an auth provider is configured.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# 32+ random bytes to keep sessions valid across restarts:
#   openssl rand -base64 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
